# Formal proof of rtl/post/argmax_unit.sv; properties in argmax_unit_props.sv. Run by test_formal.py.
# Tasks: prove (every assertion, unbounded) and cover (every cover statement reachable).
[tasks]
prove
cover

[options]
prove: mode prove
cover: mode cover
cover: depth 30

[engines]
prove: abc pdr
cover: smtbmc yices

[script]
read_verilog -formal -sv argmax_unit.sv
read_verilog -formal -sv argmax_unit_props.sv
prep -top argmax_unit_props

[files]
../../rtl/post/argmax_unit.sv
argmax_unit_props.sv
