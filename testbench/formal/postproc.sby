# Formal proof of rtl/post/postproc.sv; properties in postproc_props.sv. Run by test_formal.py.
# Tasks: prove (every assertion, unbounded) and cover (every cover statement reachable).
[tasks]
prove
cover

[options]
prove: mode prove
cover: mode cover
cover: depth 30

[engines]
prove: abc pdr
cover: smtbmc yices

[script]
read_verilog -formal -sv postproc.sv
read_verilog -formal -sv postproc_props.sv
prep -top postproc_props

[files]
../../rtl/post/postproc.sv
postproc_props.sv
