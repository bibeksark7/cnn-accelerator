# Formal proof of rtl/core/mac_cell.sv; properties in mac_cell_props.sv. Run by test_formal.py.
# Tasks: prove (every assertion, unbounded) and cover (every cover statement reachable).
[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 3
cover: mode cover
cover: depth 30

[engines]
prove: smtbmc yices
cover: smtbmc yices

[script]
read_verilog -formal -sv mac_cell.sv
read_verilog -formal -sv mac_cell_props.sv
prep -top mac_cell_props

[files]
../../rtl/core/mac_cell.sv
mac_cell_props.sv
